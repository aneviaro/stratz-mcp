{
  "$id": "urn:stratz-mcp:contract:1.0.0-draft.3:stratz_batch_get_players:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detail_level": {
      "default": "standard",
      "enum": [
        "summary",
        "standard",
        "full"
      ],
      "type": "string"
    },
    "fresh": {
      "default": false,
      "type": "boolean"
    },
    "include_raw": {
      "default": false,
      "type": "boolean"
    },
    "player_ids": {
      "items": {
        "description": "Steam account ID, SteamID64, or an https://stratz.com/players/... profile URL.",
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 25,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "player_ids"
  ],
  "type": "object"
}

    },
    "hero": {
      "oneOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "include_matchups": {
      "default": false,
      "type": "boolean"
    },
    "include_raw": {
      "default": false,
      "type": "boolean"
    },
    "include_synergies": {
      "default": false,
      "type": "boolean"
    },
    "lane": {
      "maxLength": 64,
      "type": "string"
    },
    "patch_id": {
      "maxLength": 64,
      "type": "string"
    },
    "rank_bracket": {
      "maxLength": 64,
      "type": "string"
    },
    "role": {
      "maxLength": 64,
      "type": "string"
    },
    "to": {
      "format": "date-time",
      "type": "string"
    }

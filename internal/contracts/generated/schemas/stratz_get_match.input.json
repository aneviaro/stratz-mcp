{
  "$id": "urn:stratz-mcp:contract:1.0.0-draft.3:stratz_get_match:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detail_level": {
      "default": "standard",
      "description": "Controls normalized match response breadth. players returns summary fields plus player rows without replay-derived objectives or timeline events.",
      "enum": [
        "summary",
        "players",
        "standard",
        "full"
      ],
      "type": "string"
    },
    "fresh": {
      "default": false,
      "type": "boolean"
    },
    "include_raw": {
      "default": false,
      "type": "boolean"
    },
    "match_id": {
      "pattern": "^[0-9]{1,20}$",
      "type": "string"
    }
  },
  "required": [
    "match_id"
  ],
  "type": "object"
}

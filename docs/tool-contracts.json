{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aneviaro/stratz-mcp/docs/tool-contracts.json",
  "contractVersion": "2.0.0-draft.1",
  "mcpProtocolVersion": "2026-07-28",
  "supportedMcpProtocolVersions": ["2026-07-28", "2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05"],
  "description": "Canonical machine-readable MCP tool contract registry for the v2 query surface.",
  "rawGraphqlPolicy": {
    "operationTypes": {"query": "allow_subject_to_root_policy", "mutation": "deny", "subscription": "deny"},
    "rootFieldDefault": "deny",
    "allowedRootFields": ["constants", "guild", "heroStats", "leaderboard", "league", "leagues", "live", "match", "matches", "player", "players", "team", "teams"],
    "deniedRootFields": ["plus", "stratz", "vendor", "yogurt"],
    "metaFields": {"__typename": "allow", "__schema": "allow_only_with_runtime_introspection_flag", "__type": "allow_only_with_runtime_introspection_flag"},
    "unknownRootFields": "deny_until_policy_revision"
  },
  "$defs": {
    "dateTime": {"type": "string", "format": "date-time"},
    "nullableDateTime": {"type": ["string", "null"], "format": "date-time"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 2048},
    "matchId": {"type": "string", "pattern": "^[0-9]{1,20}$"},
    "heroIdentifier": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1, "maxLength": 128}]},
    "detailLevel": {"type": "string", "enum": ["summary", "standard", "full"], "default": "standard"},
    "matchDetailLevel": {"type": "string", "enum": ["summary", "players", "standard", "full"], "default": "standard"},
    "exactMatchDetailLevel": {"$ref": "#/$defs/matchDetailLevel"},
    "playerHistoryDetailLevel": {"type": "string", "enum": ["summary", "players"], "default": "summary"},
    "leagueHistoryDetailLevel": {"type": "string", "enum": ["summary"], "default": "summary"},
    "pagination": {
      "type": "object",
      "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}, "cursor": {"type": "string", "minLength": 1, "maxLength": 4096}},
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "retrieved_at": {"$ref": "#/$defs/dateTime"},
        "detail_level": {"type": ["string", "null"], "enum": ["summary", "players", "standard", "full", null]},
        "operation": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "cache": {
          "type": "object",
          "properties": {"status": {"type": "string", "enum": ["hit", "miss", "stale", "bypass", "disabled"]}, "age_seconds": {"type": ["integer", "null"], "minimum": 0}},
          "required": ["status", "age_seconds"], "additionalProperties": false
        },
        "patch": {"type": ["object", "null"], "properties": {"id": {"type": ["string", "null"]}, "name": {"type": ["string", "null"]}}, "required": ["id", "name"], "additionalProperties": false},
        "date_range": {"type": ["object", "null"], "properties": {"from": {"$ref": "#/$defs/nullableDateTime"}, "to": {"$ref": "#/$defs/nullableDateTime"}}, "required": ["from", "to"], "additionalProperties": false},
        "rate_limits": {"type": "array", "maxItems": 8, "items": {"type": "object", "properties": {"window": {"type": "string", "enum": ["second", "minute", "hour", "day", "unknown"]}, "limit": {"type": ["integer", "null"], "minimum": 0}, "remaining": {"type": ["integer", "null"], "minimum": 0}, "reset_at": {"$ref": "#/$defs/nullableDateTime"}, "source": {"type": ["string", "null"], "maxLength": 128}}, "required": ["window", "limit", "remaining", "reset_at", "source"], "additionalProperties": false}}
      },
      "required": ["retrieved_at", "operation", "schema_version", "detail_level", "cache", "patch", "date_range", "rate_limits"],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "enum": ["INVALID_ARGUMENT", "NOT_FOUND", "PRIVATE", "DATA_NOT_READY", "RATE_LIMITED", "UPSTREAM_TIMEOUT", "UPSTREAM_NETWORK_ERROR", "UPSTREAM_TLS_ERROR", "UPSTREAM_WAF_BLOCKED", "UPSTREAM_PROTOCOL_ERROR", "UPSTREAM_PARTIAL_ERROR", "UPSTREAM_ERROR", "RESPONSE_TOO_LARGE", "QUERY_DOCUMENT_TOO_LARGE", "QUERY_VARIABLES_TOO_LARGE", "QUERY_DEPTH_EXCEEDED", "QUERY_ALIAS_LIMIT_EXCEEDED", "QUERY_FIELD_LIMIT_EXCEEDED", "QUERY_COMPLEXITY_EXCEEDED", "QUERY_LIST_LIMIT_REQUIRED", "QUERY_LIST_LIMIT_EXCEEDED", "QUERY_OPERATION_LIMIT_EXCEEDED", "QUERY_OPERATION_NOT_ALLOWED", "INTROSPECTION_DISABLED", "REQUEST_BUDGET_EXCEEDED", "AUTHENTICATION_FAILED", "CURSOR_INVALID", "CURSOR_EXPIRED", "CACHE_UNAVAILABLE", "INTERNAL_ERROR"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 2048},
        "retryable": {"type": "boolean"},
        "retry_after": {"$ref": "#/$defs/nullableDateTime"},
        "failed_input": {},
        "details": {"type": "object", "maxProperties": 32, "additionalProperties": true}
      },
      "required": ["code", "message", "retryable", "retry_after", "details"],
      "additionalProperties": false
    },
    "errorResult": {
      "type": "object",
      "properties": {"kind": {"const": "error"}, "error": {"$ref": "#/$defs/error"}, "context": {"$ref": "#/$defs/matchAvailabilityContext"}},
      "required": ["kind", "error"],
      "additionalProperties": false,
      "allOf": [{
        "if": {"properties": {"error": {"properties": {"code": {"const": "DATA_NOT_READY"}}, "required": ["code"]}}, "required": ["error"]},
        "then": {"required": ["context"]},
        "else": {"not": {"required": ["context"]}}
      }]
    },

    "success": {
      "type": "object",
      "properties": {"kind": {"const": "success"}, "data": {"type": "object"}, "summary": {"type": ["string", "null"], "maxLength": 4096}, "provenance": {"$ref": "#/$defs/provenance"}, "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1024}}, "raw": {"type": ["object", "array", "null"]}},
      "required": ["kind", "data", "summary", "provenance", "warnings"],
      "additionalProperties": false
    },
    "player": {
      "type": "object",
      "properties": {
        "account_id": {"type": "string", "pattern": "^[0-9]{1,10}$"}, "steam_id64": {"type": ["string", "null"], "pattern": "^[0-9]{17,20}$"}, "display_name": {"type": ["string", "null"], "maxLength": 256}, "avatar_url": {"type": ["string", "null"], "format": "uri"}, "is_private": {"type": "boolean"},
        "rank": {"type": ["object", "null"], "properties": {"rank_tier": {"type": ["integer", "null"], "minimum": 0}, "leaderboard_rank": {"type": ["integer", "null"], "minimum": 1}}, "required": ["rank_tier", "leaderboard_rank"], "additionalProperties": false},
        "match_count": {"type": ["integer", "null"], "minimum": 0}, "win_count": {"type": ["integer", "null"], "minimum": 0}, "last_match_at": {"$ref": "#/$defs/nullableDateTime"},
        "statistics": {"type": ["object", "null"], "properties": {"match_count": {"type": "integer", "minimum": 0}, "win_count": {"type": "integer", "minimum": 0}, "last_match_at": {"$ref": "#/$defs/nullableDateTime"}}, "required": ["match_count", "win_count", "last_match_at"], "additionalProperties": false}
      },
      "required": ["account_id", "steam_id64", "display_name", "avatar_url", "is_private", "rank"], "additionalProperties": false
    },
    "matchSummary": {
      "type": "object",
      "properties": {"match_id": {"$ref": "#/$defs/matchId"}, "started_at": {"$ref": "#/$defs/nullableDateTime"}, "duration_seconds": {"type": ["integer", "null"], "minimum": 0}, "radiant_win": {"type": ["boolean", "null"]}, "radiant_score": {"type": ["integer", "null"], "minimum": 0}, "dire_score": {"type": ["integer", "null"], "minimum": 0}, "game_mode_id": {"type": ["integer", "null"]}, "lobby_type_id": {"type": ["integer", "null"]}, "region_id": {"type": ["integer", "null"]}, "league_id": {"type": ["string", "null"]}, "patch_id": {"type": ["string", "null"]}, "parse_status": {"type": "string", "enum": ["parsed", "partial", "pending", "unavailable", "unknown"]}},
      "required": ["match_id", "started_at", "duration_seconds", "radiant_win", "radiant_score", "dire_score", "game_mode_id", "lobby_type_id", "region_id", "league_id", "patch_id", "parse_status"], "additionalProperties": false
    },
    "playerMatchSummary": {"type": "object", "properties": {"match_id": {"$ref": "#/$defs/matchId"}, "started_at": {"$ref": "#/$defs/nullableDateTime"}, "duration_seconds": {"type": ["integer", "null"], "minimum": 0}, "radiant_win": {"type": ["boolean", "null"]}, "radiant_score": {"type": ["integer", "null"], "minimum": 0}, "dire_score": {"type": ["integer", "null"], "minimum": 0}, "game_mode_id": {"type": ["integer", "null"]}, "lobby_type_id": {"type": ["integer", "null"]}, "region_id": {"type": ["integer", "null"]}, "league_id": {"type": ["string", "null"]}, "patch_id": {"type": ["string", "null"]}, "parse_status": {"type": "string", "enum": ["parsed", "partial", "pending", "unavailable", "unknown"]}, "player": {"oneOf": [{"$ref": "#/$defs/matchPlayer"}, {"type": "null"}]}}, "required": ["match_id", "started_at", "duration_seconds", "radiant_win", "radiant_score", "dire_score", "game_mode_id", "lobby_type_id", "region_id", "league_id", "patch_id", "parse_status"], "additionalProperties": false},
    "matchPlayer": {"type": "object", "properties": {"account_id": {"type": ["string", "null"]}, "hero_id": {"type": ["integer", "null"], "minimum": 1}, "team": {"type": "string", "enum": ["radiant", "dire"]}, "position": {"type": "integer", "minimum": 0, "maximum": 9}, "kills": {"type": "integer", "minimum": 0}, "deaths": {"type": "integer", "minimum": 0}, "assists": {"type": "integer", "minimum": 0}, "networth": {"type": ["integer", "null"], "minimum": 0}, "level": {"type": ["integer", "null"], "minimum": 0}, "won": {"type": ["boolean", "null"]}}, "required": ["account_id", "hero_id", "team", "position", "kills", "deaths", "assists", "networth", "level", "won"], "additionalProperties": false},
    "livePlayer": {"type": "object", "properties": {"account_id": {"type": ["string", "null"]}, "hero_id": {"type": ["integer", "null"], "minimum": 1}, "team": {"type": "string", "enum": ["radiant", "dire"]}, "position": {"type": "integer", "minimum": 0, "maximum": 9}, "kills": {"type": "integer", "minimum": 0}, "deaths": {"type": "integer", "minimum": 0}, "assists": {"type": "integer", "minimum": 0}, "networth": {"type": ["integer", "null"], "minimum": 0}, "level": {"type": ["integer", "null"], "minimum": 0}, "won": {"type": ["boolean", "null"]}}, "required": ["account_id", "hero_id", "team", "position", "kills", "deaths", "assists", "networth", "level", "won"], "additionalProperties": false},
    "event": {"type": "object", "properties": {"time_seconds": {"type": "integer", "minimum": 0}, "type": {"type": "string", "maxLength": 64}, "team": {"type": ["string", "null"], "enum": ["radiant", "dire", null]}, "account_id": {"type": ["string", "null"]}, "hero_id": {"type": ["integer", "null"], "minimum": 1}, "value": {"type": ["integer", "number", "string", "boolean", "null"]}}, "required": ["time_seconds", "type", "team", "account_id", "hero_id", "value"], "additionalProperties": false},
    "matchAvailabilityContext": {"type": "object", "properties": {"type": {"const": "match_availability"}, "match": {"$ref": "#/$defs/matchSummary"}, "requested_detail_level": {"$ref": "#/$defs/detailLevel"}}, "required": ["type", "match", "requested_detail_level"], "additionalProperties": false},
    "match": {"type": "object", "properties": {"match_id": {"$ref": "#/$defs/matchId"}, "started_at": {"$ref": "#/$defs/nullableDateTime"}, "duration_seconds": {"type": ["integer", "null"], "minimum": 0}, "radiant_win": {"type": ["boolean", "null"]}, "radiant_score": {"type": ["integer", "null"], "minimum": 0}, "dire_score": {"type": ["integer", "null"], "minimum": 0}, "game_mode_id": {"type": ["integer", "null"]}, "lobby_type_id": {"type": ["integer", "null"]}, "region_id": {"type": ["integer", "null"]}, "league_id": {"type": ["string", "null"]}, "patch_id": {"type": ["string", "null"]}, "parse_status": {"type": "string", "enum": ["parsed", "partial", "pending", "unavailable", "unknown"]}, "players": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/matchPlayer"}}, "objectives": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/event"}}, "timeline": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/event"}}}, "required": ["match_id", "started_at", "duration_seconds", "radiant_win", "radiant_score", "dire_score", "game_mode_id", "lobby_type_id", "region_id", "league_id", "patch_id", "parse_status", "players"], "additionalProperties": false},
    "hero": {
      "type": "object",
      "properties": {"hero_id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1, "maxLength": 128}, "slug": {"type": "string", "minLength": 1, "maxLength": 128}, "localized_name": {"type": ["string", "null"], "maxLength": 128}, "primary_attribute": {"type": ["string", "null"], "enum": ["strength", "agility", "intelligence", "universal", null]}, "attack_type": {"type": ["string", "null"], "enum": ["melee", "ranged", null]}, "roles": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 64}}, "statistics": {"type": ["object", "null"], "properties": {"sample_size": {"type": "integer", "minimum": 0}, "pick_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "win_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}, "required": ["sample_size", "pick_rate", "win_rate"], "additionalProperties": false}},
      "required": ["hero_id", "name", "slug", "localized_name", "primary_attribute", "attack_type", "roles"], "additionalProperties": false
    },
    "league": {
      "type": "object",
      "properties": {"league_id": {"type": "string", "minLength": 1, "maxLength": 32}, "name": {"type": "string", "minLength": 1, "maxLength": 256}, "tier": {"type": ["string", "null"], "maxLength": 64}, "status": {"type": ["string", "null"], "maxLength": 64}, "region": {"type": ["string", "null"], "maxLength": 128}, "starts_at": {"$ref": "#/$defs/nullableDateTime"}, "ends_at": {"$ref": "#/$defs/nullableDateTime"}},
      "required": ["league_id", "name", "tier", "status", "region", "starts_at", "ends_at"], "additionalProperties": false
    },
    "liveMatch": {"type": "object", "properties": {"match_id": {"$ref": "#/$defs/matchId"}, "started_at": {"$ref": "#/$defs/nullableDateTime"}, "duration_seconds": {"type": ["integer", "null"], "minimum": 0}, "game_mode_id": {"type": ["integer", "null"]}, "spectator_count": {"type": ["integer", "null"], "minimum": 0}, "league": {"oneOf": [{"$ref": "#/$defs/league"}, {"type": "null"}]}, "radiant_team_name": {"type": ["string", "null"], "maxLength": 256}, "dire_team_name": {"type": ["string", "null"], "maxLength": 256}, "players": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/livePlayer"}}}, "required": ["match_id", "started_at", "duration_seconds", "game_mode_id", "spectator_count", "league", "radiant_team_name", "dire_team_name", "players"], "additionalProperties": false},
    "constant": {"type": "object", "properties": {"type": {"type": "string", "enum": ["heroes", "items", "abilities", "game_modes", "regions", "game_versions"]}, "id": {"type": "string", "minLength": 1, "maxLength": 64}, "name": {"type": "string", "minLength": 1, "maxLength": 256}, "localized_name": {"type": ["string", "null"], "maxLength": 256}, "metadata": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}}}, "required": ["type", "id", "name", "localized_name", "metadata"], "additionalProperties": false},
    "page": {"type": "object", "properties": {"next_cursor": {"type": ["string", "null"], "maxLength": 4096}, "has_more": {"type": "boolean"}}, "required": ["next_cursor", "has_more"], "additionalProperties": false},
    "commonControls": {"type": "object", "properties": {"fresh": {"type": "boolean", "default": false}, "include_raw": {"type": "boolean", "default": false}}, "additionalProperties": false},
    "querySuccess": {"allOf": [{"$ref": "#/$defs/success"}, {"properties": {"data": {"type": "object", "required": ["mode", "items"], "properties": {"mode": {"type": "string"}, "items": {"type": "array"}, "page": {"$ref": "#/$defs/page"}}, "additionalProperties": false}}}]}
  },
  "tools": {
    "stratz_server_info": {
      "description": "Return server, protocol, schema, cache, limits, and upstream status.",
      "inputSchema": {"type": "object", "additionalProperties": false},
      "outputSchema": {"oneOf": [{"allOf": [{"$ref": "#/$defs/success"}, {"properties": {"data": {"type": "object", "properties": {"server_version": {"type": "string"}, "mcp_protocol_version": {"const": "2026-07-28"}, "supported_mcp_protocol_versions": {"type": "array", "items": {"type": "string"}, "minItems": 5, "maxItems": 5}, "schema_version": {"type": "string"}, "cache_status": {"type": "string", "enum": ["healthy", "disabled", "degraded"]}, "upstream_status": {"type": "string", "enum": ["reachable", "authentication_failed", "waf_blocked", "unreachable", "unchecked"]}, "limits": {"type": "object", "additionalProperties": {"type": ["integer", "string", "boolean"]}}}, "required": ["server_version", "mcp_protocol_version", "supported_mcp_protocol_versions", "schema_version", "cache_status", "upstream_status", "limits"], "additionalProperties": false}}}]}, {"$ref": "#/$defs/errorResult"}]}
    },
    "stratz_query_players": {
      "description": "Query normalized players by one to 25 exact identifiers.",
      "inputSchema": {"oneOf": [{"type": "object", "properties": {"mode": {"const": "exact"}, "player_ids": {"type": "array", "minItems": 1, "maxItems": 25, "items": {"$ref": "#/$defs/identifier"}}, "include_profile_statistics": {"type": "boolean", "default": false}, "fresh": {"type": "boolean", "default": false}, "include_raw": {"type": "boolean", "default": false}}, "required": ["mode", "player_ids"], "additionalProperties": false}]},
      "outputSchema": {"oneOf": [{"allOf": [{"$ref": "#/$defs/querySuccess"}, {"properties": {"data": {"properties": {"mode": {"const": "exact"}, "items": {"minItems": 1, "maxItems": 25, "items": {"$ref": "#/$defs/player"}}}}}}]}, {"$ref": "#/$defs/errorResult"}]}
    },
    "stratz_query_matches": {
      "description": "Query normalized matches by exact IDs, history filters, or live filters.",
      "inputSchema": {"oneOf": [
        {"type": "object", "properties": {"mode": {"const": "exact"}, "match_ids": {"type": "array", "minItems": 1, "maxItems": 25, "items": {"$ref": "#/$defs/matchId"}}, "detail_level": {"$ref": "#/$defs/exactMatchDetailLevel"}, "fresh": {"type": "boolean", "default": false}, "include_raw": {"type": "boolean", "default": false}}, "required": ["mode", "match_ids"], "additionalProperties": false},
        {"type": "object", "properties": {"mode": {"const": "player_history"}, "player_id": {"$ref": "#/$defs/identifier"}, "from": {"$ref": "#/$defs/dateTime"}, "to": {"$ref": "#/$defs/dateTime"}, "hero": {"$ref": "#/$defs/heroIdentifier"}, "role": {"type": "string", "maxLength": 64}, "game_mode_id": {"type": "integer"}, "lobby_type_id": {"type": "integer"}, "result": {"type": "string", "enum": ["win", "loss"]}, "minimum_duration_seconds": {"type": "integer", "minimum": 0, "maximum": 21600}, "patch_id": {"type": "string", "maxLength": 64}, "detail_level": {"$ref": "#/$defs/playerHistoryDetailLevel"}, "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}, "cursor": {"type": "string", "maxLength": 4096}, "fresh": {"type": "boolean", "default": false}, "include_raw": {"type": "boolean", "default": false}}, "required": ["mode", "player_id"], "additionalProperties": false},
        {"type": "object", "properties": {"mode": {"const": "league_history"}, "league_id": {"type": "string", "minLength": 1, "maxLength": 32}, "from": {"$ref": "#/$defs/dateTime"}, "to": {"$ref": "#/$defs/dateTime"}, "patch_id": {"type": "string", "maxLength": 64}, "detail_level": {"$ref": "#/$defs/leagueHistoryDetailLevel"}, "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}, "cursor": {"type": "string", "maxLength": 4096}, "fresh": {"type": "boolean", "default": false}, "include_raw": {"type": "boolean", "default": false}}, "required": ["mode", "league_id"], "additionalProperties": false},
        {"type": "object", "properties": {"mode": {"const": "live"}, "player_id": {"$ref": "#/$defs/identifier"}, "team_id": {"type": "string", "maxLength": 32}, "league_id": {"type": "string", "maxLength": 32}, "hero": {"$ref": "#/$defs/heroIdentifier"}, "game_states": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 64}}, "tiers": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 64}}, "game_mode_id": {"type": "integer"}, "minimum_spectators": {"type": "integer", "minimum": 0}, "sort": {"type": "string", "enum": ["newest", "highest_profile"], "default": "highest_profile"}, "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}, "cursor": {"type": "string", "maxLength": 4096}, "fresh": {"type": "boolean", "default": false}, "include_raw": {"type": "boolean", "default": false}}, "required": ["mode"], "additionalProperties": false}
      ]},
      "outputSchema": {"oneOf": [
        {"allOf": [{"$ref": "#/$defs/querySuccess"}, {"properties": {"data": {"properties": {"mode": {"const": "exact"}, "items": {"minItems": 1, "maxItems": 25, "items": {"$ref": "#/$defs/match"}}}}}}]},
        {"allOf": [{"$ref": "#/$defs/querySuccess"}, {"properties": {"data": {"properties": {"mode": {"const": "player_history"}, "items": {"maxItems": 100, "items": {"$ref": "#/$defs/playerMatchSummary"}, "minItems": 0}, "page": {"$ref": "#/$defs/page"}, "required": ["page"]}}}}]},
        {"allOf": [{"$ref": "#/$defs/querySuccess"}, {"properties": {"data": {"properties": {"mode": {"const": "league_history"}, "items": {"maxItems": 100, "items": {"$ref": "#/$defs/matchSummary"}, "minItems": 0}, "page": {"$ref": "#/$defs/page"}, "required": ["page"]}}}}]},
        {"allOf": [{"$ref": "#/$defs/querySuccess"}, {"properties": {"data": {"properties": {"mode": {"const": "live"}, "items": {"maxItems": 100, "items": {"$ref": "#/$defs/liveMatch"}, "minItems": 0}, "page": {"$ref": "#/$defs/page"}, "required": ["page"]}}}}]},
        {"$ref": "#/$defs/errorResult"}
      ]}
    },
    "stratz_query_heroes": {
      "description": "Query normalized heroes exactly or by bounded search with optional statistics.",
      "inputSchema": {"oneOf": [
        {"type": "object", "properties": {"mode": {"const": "exact"}, "heroes": {"type": "array", "minItems": 1, "maxItems": 25, "items": {"$ref": "#/$defs/heroIdentifier"}}, "include_statistics": {"type": "boolean", "default": false}, "from": {"$ref": "#/$defs/dateTime"}, "to": {"$ref": "#/$defs/dateTime"}, "rank_bracket": {"type": "string", "maxLength": 64}, "role": {"type": "string", "maxLength": 64}, "fresh": {"type": "boolean", "default": false}, "include_raw": {"type": "boolean", "default": false}}, "required": ["mode", "heroes"], "additionalProperties": false},
        {"type": "object", "properties": {"mode": {"const": "search"}, "query": {"type": "string", "minLength": 1, "maxLength": 128}, "include_statistics": {"type": "boolean", "default": false}, "from": {"$ref": "#/$defs/dateTime"}, "to": {"$ref": "#/$defs/dateTime"}, "rank_bracket": {"type": "string", "maxLength": 64}, "role": {"type": "string", "maxLength": 64}, "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}, "cursor": {"type": "string", "maxLength": 4096}, "fresh": {"type": "boolean", "default": false}, "include_raw": {"type": "boolean", "default": false}}, "required": ["mode", "query"], "additionalProperties": false}
      ]},
      "outputSchema": {"oneOf": [{"allOf": [{"$ref": "#/$defs/querySuccess"}, {"properties": {"data": {"properties": {"mode": {"const": "exact"}, "items": {"minItems": 1, "maxItems": 25, "items": {"$ref": "#/$defs/hero"}}}}}}]}, {"allOf": [{"$ref": "#/$defs/querySuccess"}, {"properties": {"data": {"properties": {"mode": {"const": "search"}, "items": {"maxItems": 100, "items": {"$ref": "#/$defs/hero"}, "minItems": 0}, "page": {"$ref": "#/$defs/page"}, "required": ["page"]}}}}]}, {"$ref": "#/$defs/errorResult"}]}
    },
    "stratz_query_leagues": {
      "description": "Query normalized leagues exactly or by authenticated bounded search.",
      "inputSchema": {"oneOf": [
